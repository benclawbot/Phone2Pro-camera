{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phone2pro.local/schemas/version-matrix.schema.json",
  "title": "Phone2Pro firmware and package version matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "builds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "updatedAt": {"type": "string", "format": "date-time"},
    "builds": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/buildEntry"}
    }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["diagnostic-artifact", "normalized-record", "apk-hash", "derived-static-analysis", "operator-note"]
        },
        "reference": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "buildEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entryRevision",
        "status",
        "recordedAt",
        "device",
        "platform",
        "firmware",
        "cameraPackages",
        "diagnosticBuilds",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "entryRevision": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["verified", "partial", "unknown"]},
        "recordedAt": {"type": "string", "format": "date-time"},
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manufacturer", "model", "device", "product", "socManufacturer", "socModel"],
          "properties": {
            "manufacturer": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "device": {"type": "string", "minLength": 1},
            "product": {"type": "string", "minLength": 1},
            "socManufacturer": {"type": "string", "minLength": 1},
            "socModel": {"type": "string", "minLength": 1}
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "androidRelease",
            "sdkInt",
            "securityPatch",
            "buildFingerprint",
            "buildId",
            "buildNumber",
            "buildType",
            "buildTags"
          ],
          "properties": {
            "androidRelease": {"type": "string", "minLength": 1},
            "sdkInt": {"type": "integer", "minimum": 1},
            "securityPatch": {"type": "string", "format": "date"},
            "buildFingerprint": {"type": "string", "minLength": 1},
            "buildId": {"type": "string", "minLength": 1},
            "buildNumber": {"type": "string", "minLength": 1},
            "buildType": {"type": "string", "minLength": 1},
            "buildTags": {"type": "string", "minLength": 1}
          }
        },
        "firmware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "versionName", "region", "status", "notes"],
          "properties": {
            "distribution": {"type": "string", "minLength": 1},
            "versionName": {"type": ["string", "null"]},
            "region": {"type": "string", "minLength": 1},
            "status": {"type": "string", "enum": ["verified", "partial", "unknown"]},
            "notes": {"type": "string", "minLength": 1}
          }
        },
        "cameraPackages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "packageName",
              "versionName",
              "versionCode",
              "sha256",
              "status",
              "artifactHandling",
              "evidence"
            ],
            "properties": {
              "packageName": {"type": "string", "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)+$"},
              "versionName": {"type": "string", "minLength": 1},
              "versionCode": {"type": ["integer", "null"], "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "status": {"type": "string", "enum": ["verified", "partial", "unknown"]},
              "artifactHandling": {"type": "string", "minLength": 1},
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/evidenceReference"}
              }
            }
          }
        },
        "diagnosticBuilds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "status", "sourceArtifacts", "notes"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "label": {"type": "string", "minLength": 1},
              "status": {"type": "string", "enum": ["verified", "partial", "unknown"]},
              "sourceArtifacts": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "notes": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceReference"}
        }
      }
    }
  }
}
